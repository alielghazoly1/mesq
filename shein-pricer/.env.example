# انسخ الملف ده باسم .env (في نفس الفولدر) وحط فيه القيم الحقيقية.
# .env نفسه متجاهَل في git — المفتاح عمره ما يترفع.

# ===== RapidAPI (Shein Scraper API) =====
# المفتاح: من صفحة الـ API على RapidAPI ← تاب Headers ← قيمة x-rapidapi-key
RAPIDAPI_KEY=

# لينك endpoint "Product Details" زي ما هو في تاب Code snippet (من غير ?goods_id=... وباقي الكلام).
# اللي تحت ده تخمين لشكله. لو طلع غلط، المنصة بتجرّب الأشكال المعروفة لوحدها (على نفس الـ host)
# وبتحفظ اللي اشتغل — ولو ولا واحد اشتغل، انسخ اللينك الصح من الـ Code snippet وحطه هنا.
RAPIDAPI_PRODUCT_URL=https://shein-scraper-api.p.rapidapi.com/product/details
# الـ host بيتاخد من اللينك اللي فوق لوحده؛ اكتبه هنا بس لو الـ Code snippet فيه x-rapidapi-host مختلف.
RAPIDAPI_HOST=

# بنسأل عن السعر في شي إن السعودية بالريال
SHEIN_COUNTRY=sa
SHEIN_CURRENCY=sar
SHEIN_LANGUAGE=ar

# ===== حماية الطلبات المجانية =====
# أقصى عدد طلبات للـ API في اليوم وفي الشهر (0 = من غير حد).
# الخطة المجانية 50 طلب، فسايبين شوية احتياطي. لما تدفع زوّدهم.
MAX_API_CALLS_PER_DAY=20
MAX_API_CALLS_PER_MONTH=45
# سعر المنتج بيتحفظ كام ساعة قبل ما نسأل عليه تاني
CACHE_HOURS=6

# ===== التسعير =====
# الريال بكام جنيه عندكم (ينفع تغيّره بعدين من صفحة /admin من غير ما تلمس الملف ده)
SAR_TO_EGP=
# تقريب السعر بالمصري لفوق لأقرب كام جنيه (1 = أقرب جنيه، 5 = أقرب 5 جنيه...)
ROUND_TO=1
# true = يظهر السعر بالريال جنب السعر بالمصري للعميل
SHOW_SAR=false

# ===== صفحة العميل =====
STORE_NAME=حاسبة الأسعار
# رقم الواتساب اللي الطلبات بتوصله، بالصيغة الدولية من غير + (مثال: 201001234567)
WHATSAPP_NUMBER=

# ===== لوحة الإدارة (/admin) =====
# كلمة سر طويلة من اختيارك؛ لو فاضية اللوحة بتفضل مقفولة
ADMIN_PASSWORD=

# ===== السيرفر =====
PORT=3100
# خليه true لو السيرفر شغال ورا Nginx (عشان حد الطلبات لكل عميل يشوف الـ IP الحقيقي)
TRUST_PROXY=false
