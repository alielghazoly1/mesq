# انسخ الملف ده باسم .env وحط فيه بياناتك الحقيقية
# متلمّش الملف ده نفسه، وماترفعوش على GitHub لو الريبو عام

# رابط الاتصال بقاعدة بيانات MongoDB Atlas (هتلاقيه في لوحة تحكم Atlas بعد ما تعمل Cluster)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/weddingdb?retryWrites=true&w=majority

# البورت اللي السيرفر هيشتغل عليه محليًا (Nginx هيعمل proxy عليه)
PORT=3000

# ===== Cloudinary — مطلوبة لأي رفع ملفات =====
# من غيرها: رفع صور الدعوات، الموسيقى، وإيصالات الدفع كلها هتقع.
# هتلاقيها في لوحة تحكم Cloudinary تحت Product Environment / API Keys.
# ومهم: المفتاح لازم يكون معاه Product Environment Role، غير كده الرفع
# هيرجع 403 حتى لو المفاتيح صح.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# كلمة سر لوحة التحكم (/admin)
# اختار سلسلة عشوائية طويلة بنفسك، وحطها هنا ومتشاركهاش مع حد.
# لو سبتها فاضية، صفحة الإحصائيات هتفضل مقفولة تمامًا لأي حد.
ADMIN_SECRET=

# ===== XPay — الدفع الأوتوماتيكي بالفيزا (اختياري) =====
# لو مظبوطتش، الموقع بيرجع للتحويل اليدوي (فودافون كاش / تحويل بنكي) عادي.
# المفاتيح دي سرية — عمرها ما تترفع على GitHub، تتحط في env السيرفر بس.
# هتلاقيها في لوحة XPay تحت Developers / API Keys و Webhooks.
#
# القفل الرئيسي: لازم 'true' عشان الدفع بالفيزا يشتغل
XPAY_ENABLED=false
# عنوان الـ API (سيبه زي ما هو إلا لو XPay قالتلك غيره)
XPAY_API_BASE=https://api.xpay.app
# المفتاح العلني (بيبدأ بـ pk_) والسري (بيبدأ بـ sk_)
XPAY_PUBLISHABLE_KEY=
XPAY_SECRET_KEY=
# سر الـ webhook (بيبدأ بـ whsec_) — بتعمله في لوحة XPay وبتوجّهه على
# https://your-domain/api/pay/xpay/webhook
XPAY_WEBHOOK_SECRET=
# XPay بتقبل الجنيه المصري بس. العميل اللي سعره بالدولار بيتشحن المقابل
# بالجنيه (بطاقته الدولية بتحوّل عادي). ظبّط سعر الصرف حسب السوق:
XPAY_USD_TO_EGP=50

# اختياري: دومينات خارجية (لو فيه) مسموح لها تتواصل مع الـ API عبر CORS،
# مفصولة بفاصلة (مثال: https://blog.example.com,https://app.example.com).
# الموقع نفسه (الصفحة الرئيسية، صفحات الدعوات، لوحة التحكم) بيشتغل صح
# من غير ما تحتاج تحط أي حاجة هنا، لأنه كله بيتقدّم من نفس الأوريجن.
ALLOWED_ORIGINS=
